---
import Layout from '@/layouts/Layout.astro';
import YouTubeFacade from '@/components/YouTubeFacade.astro';
import { client } from '@/lib/sanity/client';
import { videosQuery } from '@/lib/sanity/queries';
import type { Video } from '@/lib/sanity/types';

const sampleReportages = [
  {
    title: 'Sur les sentiers de nos origines : Deux mémoires vivantes à Kouaba',
    youtubeId: 'ybX-BRTwkN8',
    duration: '33:47',
    location: 'Kouaba, Atacora',
    excerpt: 'Grand reportage à la rencontre des aînés de Kouaba, dépositaires de récits oraux séculaires sur les premières installations et les pactes d\'alliance ancestraux.',
  },
  {
    title: 'Koutchati : Au cœur des fêtes et danses populaires du Koutammakou',
    youtubeId: 'TaKVZXjLO1I',
    duration: '09:06',
    location: 'Pays Tammari',
    excerpt: 'Immersion au rythme des tambours et des réjouissances collectives de la manifestation culturelle Koutchati avec Mathieu Kommou N\'Dah.',
  },
];

let sanityVideos: Video[] = [];

try {
  sanityVideos = await client.fetch(videosQuery);
} catch (e) {
  // Mode résilient
}

const allReportages = [
  ...sampleReportages,
  ...(sanityVideos || []).map((v) => ({
    title: v.title,
    youtubeId: v.youtubeId,
    duration: v.duration || '20:00',
    location: v.territories?.[0]?.name || 'Kotamagou',
    excerpt: v.summary,
  })),
];
---

<Layout
  title="Reportages"
  description="Grands reportages de terrain au cœur du Koutammakou — Récits de villages, paysages de l'Atacora et vie des communautés."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <header class="max-w-3xl mb-12 pb-6 border-b border-sable-dark">
      <span class="badge-category mb-3">Journalisme de terrain</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-charbon mb-4">
        Grands Reportages
      </h1>
      <p class="font-body text-lg text-charbon-muted leading-relaxed m-0">
        Aller sur place, écouter les anciens, documenter les savoirs matériels et immatériels, et faire entendre les voix de celles et ceux qui habitent et font vivre le Koutammakou.
      </p>
    </header>

    <div class="space-y-16">
      {allReportages.map((reportage) => (
        <article class="bg-white border border-sable-dark p-6 sm:p-8 rounded-sm grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7">
            <YouTubeFacade
              youtubeId={reportage.youtubeId}
              title={reportage.title}
              duration={reportage.duration}
            />
          </div>
          <div class="lg:col-span-5 flex flex-col justify-between h-full">
            <div>
              <div class="flex items-center gap-2 text-xs font-ui text-ocre font-semibold uppercase tracking-wider mb-2">
                <span>📍 {reportage.location}</span>
                <span>•</span>
                <span>Durée : {reportage.duration}</span>
              </div>
              <h2 class="font-heading text-2xl sm:text-3xl font-bold text-charbon mb-4 leading-snug">
                {reportage.title}
              </h2>
              <p class="font-body text-charbon-muted text-base leading-relaxed mb-6">
                {reportage.excerpt}
              </p>
            </div>
            <div class="pt-4 border-t border-sable flex justify-between items-center text-xs font-ui text-charbon-muted">
              <span>Archive de terrain vérifiée</span>
              <span class="text-ocre font-semibold">Visionner le reportage &rarr;</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>

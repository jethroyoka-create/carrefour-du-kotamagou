---
import Layout from '@/layouts/Layout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import { client } from '@/lib/sanity/client';
import { articlesQuery } from '@/lib/sanity/queries';
import { fallbackArticles } from '@/lib/sanity/fallback';
import type { Article } from '@/lib/sanity/types';

let articles: Article[] = [];
try {
  articles = await client.fetch(articlesQuery);
} catch (e) {
  // Mode hors ligne / résilience
}

const sampleArticles: Article[] = articles.length > 0 ? articles : fallbackArticles;
---

<Layout
  title="Actualités"
  description="Actualités du Koutammakou au Bénin et au Togo — Informations locales, initiatives communautaires, développement et patrimoine."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <!-- En-tête de rubrique -->
    <header class="max-w-3xl mb-12 pb-6 border-b border-sable-dark">
      <span class="badge-category mb-3">Pilier Média d'information</span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-charbon mb-4">
        Actualités du Koutammakou
      </h1>
      <p class="font-body text-lg text-charbon-muted leading-relaxed m-0">
        Suivi régulier de la vie des communautés Batammariba, des initiatives patrimoniales, des projets de développement local et des événements culturels au Bénin et au Togo.
      </p>
    </header>

    <!-- Grille des articles -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {sampleArticles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>
  </div>
</Layout>

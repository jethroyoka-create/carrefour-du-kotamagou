---
import Layout from '@/layouts/Layout.astro';
---

<Layout
  title="Recherche dans les archives et publications"
  description="Moteur de recherche statique dans l'ensemble des articles, vidéos, répertoires claniques et termes documentaires de Carrefour du Kotamagou."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 min-h-[60vh]" data-pagefind-ignore>
    <header class="border-b border-border pb-6 mb-8">
      <span class="inline-block text-xs uppercase tracking-widest font-sans font-bold text-ocre mb-2">
        Indexation documentaire statique
      </span>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-charbon leading-tight">
        Recherche dans le fonds
      </h1>
      <p class="mt-2 font-serif text-base text-charbon/80 leading-relaxed">
        Recherchez un mot-clé, un toponyme, un patronyme, un nom de clan ou un terme Ditammari dans tous les contenus indexés.
      </p>
    </header>

    <!-- Conteneur Pagefind UI -->
    <div id="pagefind-search" class="mt-8">
      <div id="search"></div>
    </div>

    <!-- Instructions et suggestions si indexation pas encore active en mode dev -->
    <div class="mt-12 p-6 bg-sable/30 border border-border rounded-sm text-sm text-charbon/80 font-sans">
      <h2 class="font-serif font-bold text-charbon text-base mb-2">Conseils de recherche</h2>
      <ul class="list-disc list-inside space-y-1 text-xs sm:text-sm">
        <li><strong>Architecture :</strong> <span class="font-mono text-ocre">Takienta, Sikien, terre, maçon, tourelles</span></li>
        <li><strong>Rites & Coutumes :</strong> <span class="font-mono text-ocre">Difwani, Dikuntri, initiation, Kouyé</span></li>
        <li><strong>Personnalités :</strong> <span class="font-mono text-ocre">Didier N'Dah, Noël Koussey, Tidouo</span></li>
        <li><strong>Territoires :</strong> <span class="font-mono text-ocre">Boukoumbé, Nadoba, Koussoucoing, Natitingou</span></li>
        <li><strong>Clans :</strong> <span class="font-mono text-ocre">Banadoba, Bèssoribè, Ossori</span></li>
      </ul>
      <p class="mt-4 text-xs text-charbon/60 italic">
        Note technique : L'index complet est généré statiquement lors du build via Pagefind. En mode développement local, l'indexation se met à jour après exécution de la commande de build.
      </p>
    </div>
  </div>

  <link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
      if (typeof PagefindUI !== 'undefined') {
        new PagefindUI({
          element: "#search",
          showSubResults: true,
          showImages: false,
          translations: {
            placeholder: "Rechercher un terme, un lieu, un clan, une personnalité...",
            clear_search: "Effacer",
            load_more: "Charger plus de résultats",
            search_label: "Recherche sur le site",
            filters_label: "Filtres",
            zero_results: "Aucun résultat trouvé pour « [SEARCH_TERM] »",
            many_results: "[COUNT] résultats trouvés pour « [SEARCH_TERM] »",
            one_result: "1 résultat trouvé pour « [SEARCH_TERM] »",
            alt_search: "Aucun résultat pour « [SEARCH_TERM] ». Résultats affichés pour « [DIFFERENT_TERM] » à la place",
            search_suggestion: "Essayez de rechercher : [SEARCH_TERM]",
            searching: "Recherche en cours..."
          }
        });
      }
    });
  </script>

  <style is:global>
    :root {
      --pagefind-ui-scale: 0.95;
      --pagefind-ui-primary: #8C3B22;
      --pagefind-ui-text: #161412;
      --pagefind-ui-background: #FAF8F4;
      --pagefind-ui-border: #DCD6CD;
      --pagefind-ui-tag: #EFECE6;
      --pagefind-ui-border-width: 1px;
      --pagefind-ui-border-radius: 2px;
      --pagefind-ui-image-border-radius: 2px;
      --pagefind-ui-font: "Public Sans", sans-serif;
    }
  </style>
</Layout>

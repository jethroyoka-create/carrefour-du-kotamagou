---
const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/actualites', label: 'Actualités' },
  { href: '/reportages', label: 'Reportages' },
  { href: '/interviews', label: 'Interviews' },
  { href: '/culture-et-traditions', label: 'Culture & Traditions' },
  { href: '/histoire-et-memoire', label: 'Histoire & Mémoire' },
  { href: '/bibliotheque', label: 'Bibliothèque' },
];

function isActive(href: string) {
  if (href === '/') {
    return pathname === '/';
  }
  return pathname.startsWith(href);
}
---

<header class="bg-kaolin border-b border-sable-dark relative z-50">
  <!-- Bandeau supérieur informatif -->
  <div class="bg-charbon text-kaolin px-4 py-1.5 text-xs font-ui">
    <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-1">
      <span class="tracking-wide">
        Média indépendant & Bibliothèque documentaire du Koutammakou • Bénin & Togo
      </span>
      <div class="flex items-center space-x-4 text-sable-dark">
        <a
          href="https://youtube.com/@carrefourdukoutammakou-lz3cq"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-kaolin transition-colors"
          aria-label="Chaîne YouTube officielle"
        >
          YouTube
        </a>
        <span>•</span>
        <a
          href="https://www.facebook.com/share/18fE9SxRk3/"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-kaolin transition-colors"
          aria-label="Page Facebook officielle"
        >
          Facebook
        </a>
        <span>•</span>
        <a
          href="https://www.tiktok.com/@carrefour.du.kout"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-kaolin transition-colors"
          aria-label="Compte TikTok officiel"
        >
          TikTok
        </a>
      </div>
    </div>
  </div>

  <!-- En-tête éditorial principal -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
    <div class="flex items-center justify-between">
      <!-- Identité du média -->
      <div class="flex-1">
        <a href="/" class="group inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ocre">
          <span class="block font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-charbon group-hover:text-ocre transition-colors">
            Carrefour du Kotamagou
          </span>
          <span class="block font-body text-xs sm:text-sm text-charbon-muted italic mt-1">
            Le média de référence sur le Koutammakou et le patrimoine Batammariba
          </span>
        </a>
      </div>

      <!-- Accès recherche & Bouton Menu Mobile -->
      <div class="flex items-center space-x-3">
        <a
          href="/recherche"
          class="inline-flex items-center gap-2 px-3 py-2 text-sm font-ui font-medium text-charbon bg-sable hover:bg-sable-dark rounded transition-colors focus-visible:ring-2 focus-visible:ring-ocre"
          title="Rechercher dans les archives"
          aria-label="Rechercher dans les archives"
        >
          <svg class="w-4 h-4 text-ocre" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <span class="hidden md:inline">Recherche</span>
        </a>

        <!-- Bouton hamburger accessible (mobile) -->
        <button
          id="mobile-menu-button"
          type="button"
          class="md:hidden p-2 rounded text-charbon hover:bg-sable focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ocre"
          aria-controls="mobile-menu"
          aria-expanded="false"
          aria-label="Ouvrir le menu de navigation"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Barre de navigation principale (Desktop) -->
  <nav class="hidden md:block border-t border-sable-dark bg-kaolin" aria-label="Navigation principale">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <ul class="flex flex-wrap items-center space-x-1 lg:space-x-2 py-0 list-none m-0 p-0">
        {navLinks.map((link) => {
          const active = isActive(link.href);
          return (
            <li>
              <a
                href={link.href}
                class={`inline-block px-3.5 py-3 text-sm font-ui font-medium tracking-wide transition-colors border-b-2 -mb-[1px] ${
                  active
                    ? 'border-ocre text-ocre font-semibold'
                    : 'border-transparent text-charbon hover:text-ocre hover:border-sable-dark'
                }`}
                aria-current={active ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </nav>

  <!-- Menu Mobile (Accessible et léger sans dépendance JS lourde) -->
  <div
    id="mobile-menu"
    class="hidden md:hidden border-t border-sable-dark bg-kaolin px-4 pt-2 pb-6"
    aria-label="Menu mobile"
  >
    <ul class="flex flex-col space-y-1 list-none m-0 p-0">
      {navLinks.map((link) => {
        const active = isActive(link.href);
        return (
          <li>
            <a
              href={link.href}
              class={`block px-3 py-2.5 rounded text-base font-ui font-medium ${
                active
                  ? 'bg-ocre-soft text-ocre font-semibold'
                  : 'text-charbon hover:bg-sable'
              }`}
              aria-current={active ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</header>

<script>
  // Gestion accessible du menu mobile
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (button && menu && iconOpen && iconClose) {
    button.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>

---
import SEO from '@/components/SEO.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: {
    publishedTime?: string;
    author?: string;
    section?: string;
  } | boolean;
  publishedTime?: string;
  category?: string;
  noindex?: boolean;
}

const { title, description, image, article, publishedTime, category, noindex } = Astro.props;
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#8C3B22" />

    <SEO
      title={title}
      description={description}
      image={image}
      article={article}
      publishedTime={publishedTime}
      category={category}
      noindex={noindex}
    />
  </head>
  <body class="bg-kaolin text-charbon min-h-screen flex flex-col font-body antialiased selection:bg-ocre-soft selection:text-ocre">
    <!-- Lien d'évitement pour l'accessibilité au clavier (WCAG AAA) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-charbon focus:text-kaolin focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-ocre"
    >
      Passer directement au contenu principal
    </a>

    <!-- En-tête éditorial -->
    <Header />

    <!-- Contenu principal -->
    <main id="main-content" class="flex-grow focus:outline-none" tabindex="-1" data-pagefind-body>
      <slot />
    </main>

    <!-- Pied de page -->
    <Footer />
  </body>
</html>

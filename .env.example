# Configuration Sanity (Dataset public - Lecture seule pour Astro SSG)
# Obtenu lors de la création de votre projet sur https://sanity.io/manage
PUBLIC_SANITY_PROJECT_ID=votre_project_id_ici
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-03-01

# URL canonique du site (Cloudflare Pages au lancement)
PUBLIC_SITE_URL=https://carrefour-du-kotamagou.pages.dev

# IMPORTANT DE SÉCURITÉ :
# - Aucun token d'écriture Sanity (write token) ne doit être renseigné ici.
# - L'URL du Deploy Hook Cloudflare Pages ne doit JAMAIS être inscrite dans ce fichier.
#   Elle se configure uniquement dans la section Webhooks de Sanity Manage (privée).
